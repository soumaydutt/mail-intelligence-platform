# Copy to .env; create each secret file outside Git. Paths resolve from this directory.
BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
DB_NAME=mailguard
DB_USERNAME=mailguard
DELIVERY_SOURCE_ID=operator
DB_PASSWORD_FILE=./secrets/db_password
JOBS_API_KEY_FILE=./secrets/jobs_api_key
VALKEY_PASSWORD_FILE=./secrets/valkey_password
RATE_LIMIT_IDENTITY_SECRET_FILE=./secrets/rate_limit_identity_secret
VALKEY_ACL_FILE=./secrets/valkey.acl
TLS_CERT_FILE=./secrets/localhost.crt
TLS_KEY_FILE=./secrets/localhost.key
